LLAMA_BIN=/path/to/llama-server
MODEL_PATH=/path/to/model.gguf
LLAMA_PORT=8081
GATEWAY_PORT=9000
SYSTEM_PROMPT=You are a helpful AI assistant.
GOLDEN_BINARY_HASH=compute_on_first_run
SOUL_GOLDEN_HASH=compute_on_first_run
RAM_MOAT=/tmp/ali-ram-moat
LOG_DIR=/path/to/ali-kernel/logs

# ── Model backend (pluggable) ───────────────────────────────────────────────
# Default backend is the local llama.cpp above. To use ANY OpenAI-compatible
# provider instead, set BACKEND_URL to its base (must include /v1). The gateway's
# capabilities (memory, tools, critique, shield) work the same across backends.
#   BACKEND_URL=https://api.openai.com/v1
#   BACKEND_URL=https://api.minimax.chat/v1
# BACKEND_API_KEY=sk-...
# BACKEND_MODEL=ornith

# Crate-aware tools reach read-only to crates.io/docs.rs. Set to 0 to disable.
# ALI_NETWORK_TOOLS=1

# Iterative dev loop (cargo new/add/build/test/clippy) — confined workspace.
# ALI_WORKSPACE=/tmp/ali-workspace
# ALI_DEV_LOOP=1
